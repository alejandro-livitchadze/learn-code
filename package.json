{
  "name": "learn-code",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && pnpm code-lint",
    "lesson": "tsx packages/lesson-compiler/src/cli.ts",
    "demand": "pnpm --filter @learn-code/demand-scanner demand",
    "traces": "pnpm --filter @learn-code/lesson-compiler traces",
    "format": "prettier --check .",
    "examples:build": "pnpm --filter \"@learn-code/mf-example-*\" --filter \"!@learn-code/mf-example-recorder\" build && pnpm --filter @learn-code/mf-example-remote-b build:broken",
    "examples:record": "pnpm --filter @learn-code/mf-example-recorder record",
    "examples:check": "pnpm examples:build && pnpm --filter @learn-code/mf-example-recorder record:check",
    "format:fix": "prettier --write .",
    "code-lint": "tsx packages/ui/scripts/code-lint.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}

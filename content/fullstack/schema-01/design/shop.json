  "scenarios": [
    {
      "id": "order-needs-customer",
      "story": "An order must belong to a customer that exists.",
      "setupSql": [
        "insert into {{customers}} ({{customerId}}, {{customerEmail}}) values (1, 'ada@example.com')"
      ],
      "probeSql": "insert into {{orders}} ({{orderId}}, {{orderCustomer}}, {{orderTotal}}) values (1, 999, 10)",
      "expect": {
        "kind": "fails",
        "sqlState": "23503"
      },
      "hintOnFail": "Nothing connects an order to a customer yet. Make the order's customer column a foreign key that points at the customers' key.",
      "misconception": "app-validation-is-enough"
    },
    {
      "id": "customer-can-reorder",
      "story": "A customer can place more than one order.",
      "setupSql": [
        "insert into {{customers}} ({{customerId}}, {{customerEmail}}) values (1, 'ada@example.com')",
        "insert into {{orders}} ({{orderId}}, {{orderCustomer}}, {{orderTotal}}) values (1, 1, 10)"
      ],
      "probeSql": "insert into {{orders}} ({{orderId}}, {{orderCustomer}}, {{orderTotal}}) values (2, 1, 10)",
      "expect": {
        "kind": "succeeds"
      },
      "hintOnFail": "The second order of the same customer was refused. The customer column on an order must not be unique: the foreign key lives on the many side.",
      "misconception": "foreign-key-on-the-one-side"
    },
    {
      "id": "email-is-unique",
      "story": "Two customers cannot share one email address.",
      "setupSql": [
        "insert into {{customers}} ({{customerId}}, {{customerEmail}}) values (1, 'ada@example.com')"
      ],
      "probeSql": "insert into {{customers}} ({{customerId}}, {{customerEmail}}) values (2, 'ada@example.com')",
      "expect": {
        "kind": "fails",
        "sqlState": "23505"
      },
      "hintOnFail": "The same email was accepted twice. Mark the email column as unique.",
      "misconception": "app-validation-is-enough"
    },
    {
      "id": "email-is-required",
      "story": "A customer without an email address is refused.",
      "setupSql": [],
      "probeSql": "insert into {{customers}} ({{customerId}}) values (1)",
      "expect": {
        "kind": "fails",
        "sqlState": "23502"
      },
      "hintOnFail": "A customer with no email was accepted. Make the email column required (not nullable).",
      "misconception": "app-validation-is-enough"
    },
    {
      "id": "total-is-required",
      "story": "An order always has a total.",
      "setupSql": [
        "insert into {{customers}} ({{customerId}}, {{customerEmail}}) values (1, 'ada@example.com')"
      ],
      "probeSql": "insert into {{orders}} ({{orderId}}, {{orderCustomer}}) values (1, 1)",
      "expect": {
        "kind": "fails",
        "sqlState": "23502"
      },
      "hintOnFail": "An order without a total was accepted. Make the total column required (not nullable).",
      "misconception": "app-validation-is-enough"
    },
    {
      "id": "email-can-change",
      "story": "A customer can change their email without breaking their orders.",
      "setupSql": [
        "insert into {{customers}} ({{customerId}}, {{customerEmail}}) values (1, 'ada@example.com')",
        "insert into {{orders}} ({{orderId}}, {{orderCustomer}}, {{orderTotal}}) values (1, 1, 10)"
      ],
      "probeSql": "update {{customers}} set {{customerEmail}} = 'grace@example.com' where {{customerId}} = 1",
      "expect": {
        "kind": "succeeds"
      },
      "hintOnFail": "Changing the email was refused. Orders should point at a key that never changes, not at the email.",
      "misconception": "email-as-primary-key"
    }
  ],
